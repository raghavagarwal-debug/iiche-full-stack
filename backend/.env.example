# =============================================================================
# IIChE Backend — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to Git.
# =============================================================================

# --- Database ---
POSTGRES_PASSWORD=123456
DATABASE_URL=postgresql://postgres:Raghav@2008@localhost:5432/iiche_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- URLs ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://localhost:8000

# --- Session & CSRF Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
CSRF_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET

# --- Session Config ---
SESSION_EXPIRE_HOURS=72

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOCK_LOGIN_ENABLED=false
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Email Provider ---
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@iiche.bitmesra.ac.in

# --- OTP Settings ---
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_SIGNUP=5/minute
# Required by docker-compose; use a long random value.
